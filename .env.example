# HealthMate Environment Configuration Guide
# ---------------------------------------------------------------------
# Note: For local development, RUN_HEALTHMATE.bat automatically configures
# backend/.env and frontend/.env for you. No manual edits are required to run locally!
#
# Backend Configuration (backend/.env):
# -------------------------------------
# ENVIRONMENT=development
# PORT=8000
# SECRET_KEY=healthmate-dev-secret-key-32-bytes-minimum-string-12345
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# DATABASE_URL=sqlite:///./healthmate.db
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://healthmate-app.netlify.app
# DATASET_PATH=data/healthmate_indian_food_dataset_1200plus.xlsx
#
# Frontend Configuration (frontend/.env):
# --------------------------------------
# VITE_API_BASE_URL=
# (Leave empty in local development to use Vite's built-in proxy to localhost:8000)
# (In production, set to your backend Render URL, e.g. https://healthmate-api.onrender.com)


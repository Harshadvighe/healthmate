# HealthMate Backend Configuration Example
# Environment
ENVIRONMENT=development
PORT=8000

# Security (Generate a secure 64-char key in production)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production PostgreSQL (Render / Supabase / Neon / Local PostgreSQL)
# Example: postgresql://healthmate_user:password@localhost:5432/healthmate_db
# In local development without Postgres, leave empty to default to SQLite: sqlite:///./healthmate.db
DATABASE_URL=sqlite:///./healthmate.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://healthmate-app.netlify.app

# Dataset paths (relative to backend directory or absolute)
DATASET_PATH=data/healthmate_indian_food_dataset_1200plus.xlsx

